{
  "manifest_version": 3,
  "name": "Pluginwhat — mensagens em sequência",
  "version": "1.4.0",
  "description": "Importe contatos TXT, alterne três mensagens e configure o intervalo no WhatsApp Web.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Pluginwhat no WhatsApp Web"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "content-main.js",
        "whatsapp.js",
        "core.js",
        "documents.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "externally_connectable": {
    "matches": [
      "https://zsites.lovable.app/*",
      "https://site-scout-ai-90.lovable.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
